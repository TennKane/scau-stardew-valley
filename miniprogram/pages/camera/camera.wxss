/* ========== 相机页 ========== */
.camera-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #1a1a1a;
}

.camera-preview {
  width: 100%;
  height: 100%;
}

/* 取景框遮罩 */
.viewfinder-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.viewfinder-frame {
  width: 280rpx;
  height: 280rpx;
  border: 4px solid rgba(245, 230, 200, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 3s ease-in-out infinite;
  position: relative;
}

.viewfinder-frame::before,
.viewfinder-frame::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: var(--color-gold);
  border-style: solid;
}

.viewfinder-frame::before {
  top: -6rpx;
  left: -6rpx;
  border-width: 4px 0 0 4px;
}

.viewfinder-frame::after {
  top: -6rpx;
  right: -6rpx;
  border-width: 4px 4px 0 0;
}

.viewfinder-icon {
  font-size: 48rpx;
  opacity: 0.6;
  animation: sparkle 2s ease-in-out infinite;
}

.hint-card {
  position: absolute;
  bottom: 160rpx;
  background: rgba(92, 61, 46, 0.85);
  padding: 12rpx 32rpx;
  border: 2px solid var(--color-gold);
  max-width: 80%;
}

.hint-text {
  color: var(--color-paper-light);
  font-size: 14px;
  text-align: center;
}

/* 底部控制栏 */
.camera-bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom, 20rpx));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
}

.btn-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-emoji {
  font-size: 36rpx;
}

.btn-shutter {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 6px solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-inner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: white;
}

.btn-shutter:active .shutter-inner {
  transform: scale(0.9);
}

/* 最近打卡条 */
.recent-bar {
  position: absolute;
  top: 120rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.recent-label {
  color: rgba(255,255,255,0.7);
  font-size: 11px;
  white-space: nowrap;
}

.recent-scroll {
  flex: 1;
  white-space: nowrap;
}

.recent-items {
  display: inline-flex;
  gap: 8rpx;
}

.recent-item {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255,255,255,0.15);
  padding: 4rpx 12rpx;
  border: 1px solid rgba(255,255,255,0.2);
}

.recent-badge {
  font-size: 20rpx;
}

.recent-name {
  color: white;
  font-size: 11px;
}

/* 打卡成功弹窗 */
.success-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 100;
}

.success-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.success-card {
  background: var(--color-paper-light);
  border: 4px solid var(--color-wood-dark);
  box-shadow: 6px 6px 0 rgba(92, 61, 46, 0.3);
  padding: 48rpx 40rpx;
  max-width: 80%;
  text-align: center;
  animation: pop-in 0.4s ease-out;
}

.success-star-container {
  margin-bottom: 16rpx;
}

.success-star {
  font-size: 64rpx;
  animation: sparkle 1s ease-in-out infinite;
}

.success-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-wood-dark);
  margin-bottom: 8rpx;
}

.success-name {
  font-size: 18px;
  font-weight: 600;
  color: var(--color-accent);
  margin-bottom: 16rpx;
}

.success-divider {
  width: 120rpx;
  height: 2px;
  background: var(--color-stardew-brown);
  margin: 0 auto 16rpx;
}

.success-desc {
  font-size: 13px;
  color: var(--color-ink);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.success-footer {
  display: flex;
  justify-content: center;
}
