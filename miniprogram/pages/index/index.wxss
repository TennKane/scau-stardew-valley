/* ========== 首页 ========== */
.page-index {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header-section {
  background: linear-gradient(180deg, var(--color-wood-dark) 0%, var(--color-paper) 100%);
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.season-emoji { font-size: 28rpx; }
.date-text { color: var(--color-paper-light); font-size: 12px; }

.subtitle {
  color: var(--color-muted);
  font-size: 13px;
  display: block;
  margin-bottom: 20rpx;
}

.progress-card {
  background: var(--color-paper-light);
  border: 2px solid var(--color-wood-dark);
  padding: 16rpx 24rpx;
}
.progress-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.progress-label { font-size: 12px; color: var(--color-muted); }
.progress-count { font-size: 14px; font-weight: 600; color: var(--color-accent); }
.progress-bar-bg {
  height: 12rpx;
  background: var(--color-stardew-brown);
  border: 1px solid var(--color-wood-dark);
}
.progress-bar-fill {
  height: 100%;
  background: var(--color-accent);
  transition: width 0.3s;
}

/* 分类 */
.category-scroll {
  padding: 20rpx 0;
  white-space: nowrap;
}
.category-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}
.category-item {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: var(--color-stardew-brown);
  color: var(--color-ink);
  font-size: 12px;
  border: 2px solid var(--color-wood-dark);
}
.category-item.active {
  background: var(--color-accent);
  color: white;
}

/* 地标卡片 */
.landmark-list {
  padding: 0 24rpx;
}
.landmark-card {
  margin-bottom: 16rpx;
}
.landmark-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}
.landmark-name {
  font-size: 18px;
  font-weight: 700;
  color: var(--color-wood-dark);
}
.landmark-stardew {
  font-size: 13px;
  color: var(--color-accent);
  display: block;
  margin-bottom: 8rpx;
  font-style: italic;
}
.landmark-desc {
  font-size: 13px;
  color: var(--color-ink);
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.5;
}
.landmark-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.landmark-difficulty { font-size: 11px; color: var(--color-muted); }
.landmark-hint { font-size: 11px; color: var(--color-muted); }

/* 探索按钮 */
.explore-fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-accent);
  border: 4px solid var(--color-wood-dark);
  box-shadow: 4px 4px 0 rgba(92, 61, 46, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.explore-fab:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 rgba(92, 61, 46, 0.3);
}
.explore-fab-icon { font-size: 36rpx; }
.explore-fab-text { font-size: 11px; color: white; font-weight: 600; }
